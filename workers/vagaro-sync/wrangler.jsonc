{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lashpop-vagaro-sync",
  "main": "src/index.ts",
  "compatibility_date": "2026-04-01",
  "compatibility_flags": ["nodejs_compat"],
  "account_id": "4f7293208a9aa982963007fffd966b56",
  "triggers": {
    // Three times daily. Vagaro meters API calls, so freshness between these
    // runs comes from webhooks and the admin's on-demand sync button.
    "crons": ["0 6,14,22 * * *"]
  },
  // Optional secret: VAGARO_MAX_METERED_CALLS_PER_RUN. Defaults to 5 and is
  // always clamped to 50; a healthy full run currently uses 2.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lashpop-production",
      "database_id": "5ff90fd7-2a8d-4c0e-baaa-341f33f8aa87"
    }
  ],
  "vars": {
    "CLOUDFLARE_ACCOUNT_ID": "4f7293208a9aa982963007fffd966b56",
    "CLOUDFLARE_IMAGES_ACCOUNT_HASH": "zXebLwufc8AGAQU5E9oXHw"
  },
  "env": {
    "admin_preview": {
      "name": "lashpop-vagaro-sync-admin-preview",
      "triggers": {
        "crons": []
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "lashpop-admin-preview",
          "database_id": "41c05e0a-8094-4703-a6dd-b2efd003e91f"
        }
      ],
      "vars": {
        "VAGARO_PUBLIC_BUSINESS_ID": "32173928",
        "CLOUDFLARE_ACCOUNT_ID": "4f7293208a9aa982963007fffd966b56",
        "CLOUDFLARE_IMAGES_ACCOUNT_HASH": "zXebLwufc8AGAQU5E9oXHw"
      }
    }
  },
  "observability": {
    "enabled": true
  }
  // Secrets (set via `wrangler secret put`):
  //   VAGARO_REGION
  //   VAGARO_CLIENT_ID
  //   VAGARO_CLIENT_SECRET
  //   VAGARO_API_BASE_URL
  //   VAGARO_BUSINESS_ID
  //   CLOUDFLARE_IMAGES_API_TOKEN — Images Read/Write token for photo mirroring
}
