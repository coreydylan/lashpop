{
  "rules": [
    {
      "sql": "select \"id\", \"vagaro_employee_id\", \"vagaro_data\", \"vagaro_public_provider_id\", \"vagaro_photo_url\", \"vagaro_photo_source_url\", \"vagaro_bio\", \"bio_override\", \"image_override\", \"is_off_vagaro\", \"name\", \"phone\", \"email\", \"role\", \"type\", \"business_name\", \"bio\", \"quote\", \"instagram\", \"instagram_url\", \"booking_url\", \"uses_lashpop_booking\", \"image_url\", \"favorite_services\", \"external_service_categories\", \"fun_fact\", \"availability\", \"display_order\", \"is_active\", \"show_on_website\", \"show_on_website_reason\", \"show_on_website_actor\", \"show_on_website_changed_at\", \"credentials\", \"created_at\", \"updated_at\", \"last_synced_at\" from \"team_members\" where (\"team_members\".\"is_active\" = ? and \"team_members\".\"show_on_website\" = ?) order by CAST(\"team_members\".\"display_order\" AS INTEGER) ASC NULLS LAST",
      "kind": "exact",
      "params": [
        1,
        1
      ]
    },
    {
      "sql": "select \"id\", \"category_id\", \"question\", \"answer\", \"display_order\", \"is_active\", \"is_featured\", \"created_at\", \"updated_at\" from \"faq_items\" where \"faq_items\".\"is_active\" = ? order by \"faq_items\".\"display_order\" asc",
      "kind": "exact",
      "params": [
        1
      ]
    },
    {
      "sql": "select \"id\", \"vagaro_service_id\", \"vagaro_parent_service_id\", \"vagaro_widget_url\", \"vagaro_service_code\", \"vagaro_data\", \"vagaro_image_url\", \"vagaro_image_source_url\", \"category_id\", \"subcategory_id\", \"name\", \"slug\", \"subtitle\", \"description\", \"vagaro_description\", \"duration_minutes\", \"price_starting\", \"image_url\", \"color\", \"display_order\", \"is_active\", \"main_category\", \"sub_category\", \"display_title\", \"key_image_asset_id\", \"use_demo_photos\", \"created_at\", \"updated_at\", \"last_synced_at\" from \"services\" where \"services\".\"slug\" = ? limit ?",
      "kind": "service-slug",
      "params": []
    },
    {
      "sql": "select \"id\", \"source\", \"rating\", \"review_count\", \"updated_at\" from \"review_stats\"",
      "kind": "exact",
      "params": []
    },
    {
      "sql": "select \"id\" from \"tags\" where \"tags\".\"name\" = ? limit ?",
      "kind": "exact",
      "params": [
        "ig_carousel",
        1
      ]
    },
    {
      "sql": "select \"services\".\"id\", \"services\".\"name\", \"services\".\"slug\", \"services\".\"subtitle\", COALESCE(\"services\".\"description\", \"services\".\"vagaro_description\"), \"services\".\"duration_minutes\", \"services\".\"price_starting\", COALESCE(\n        \"services\".\"vagaro_image_url\",\n        \"service_key_image\".\"file_path\",\n        \"subcategory_key_image\".\"file_path\"\n      ), \"services\".\"color\", \"services\".\"display_order\", \"services\".\"category_id\", \"service_categories\".\"name\", \"service_categories\".\"slug\", \"services\".\"subcategory_id\", \"service_subcategories\".\"name\", \"service_subcategories\".\"slug\", \"service_subcategories\".\"display_order\", \"services\".\"vagaro_widget_url\", \"services\".\"vagaro_service_code\", \"services\".\"key_image_asset_id\", \"services\".\"use_demo_photos\", \"services\".\"is_active\", \"services\".\"vagaro_service_id\", \"services\".\"last_synced_at\", \"services\".\"main_category\" from \"services\" left join \"service_categories\" on \"services\".\"category_id\" = \"service_categories\".\"id\" left join \"service_subcategories\" on \"services\".\"subcategory_id\" = \"service_subcategories\".\"id\" left join \"assets\" \"service_key_image\" on \"services\".\"key_image_asset_id\" = \"service_key_image\".\"id\" left join \"assets\" \"subcategory_key_image\" on \"service_subcategories\".\"key_image_asset_id\" = \"subcategory_key_image\".\"id\" where \"services\".\"is_active\" = ? order by \"services\".\"display_order\" asc",
      "kind": "exact",
      "params": [
        1
      ]
    },
    {
      "sql": "select \"id\", \"section\", \"config\", \"source_owner\", \"version\", \"updated_by_user_id\", \"created_at\", \"updated_at\" from \"website_settings\" where \"website_settings\".\"section\" = ? limit ?",
      "kind": "public-setting",
      "params": []
    },
    {
      "sql": "select \"slug\", \"updated_at\" from \"service_categories\" where (\"service_categories\".\"is_active\" = ? and \"service_categories\".\"show_in_booking\" = ?)",
      "kind": "exact",
      "params": [
        1,
        1
      ]
    },
    {
      "sql": "select \"id\", \"review_id\", \"display_order\", \"is_pinned\", \"created_at\" from \"homepage_reviews\" order by \"homepage_reviews\".\"display_order\" asc",
      "kind": "exact",
      "params": []
    },
    {
      "sql": "select \"id\", \"name\", \"display_name\", \"description\", \"display_order\", \"is_active\", \"created_at\", \"updated_at\" from \"faq_categories\" where \"faq_categories\".\"is_active\" = ? order by \"faq_categories\".\"display_order\" asc",
      "kind": "exact",
      "params": [
        1
      ]
    },
    {
      "sql": "select \"id\", \"name\", \"display_name\", \"slug\", \"description\", \"tagline\", \"icon\", \"display_order\", \"is_active\", \"source_type\", \"show_in_booking\", \"sync_status\", \"last_synced_at\", \"key_image_asset_id\", \"created_at\", \"updated_at\" from \"service_categories\" where (\"service_categories\".\"is_active\" = ? and \"service_categories\".\"show_in_booking\" = ?) order by \"service_categories\".\"display_order\" asc",
      "kind": "exact",
      "params": [
        1,
        1
      ]
    },
    {
      "sql": "select \"team_member_id\", \"vagaro_parent_title\", \"vagaro_category_id\" from \"team_member_services_vagaro\"",
      "kind": "exact",
      "params": []
    },
    {
      "sql": "select \"vagaro_category_id\", \"title\", \"team_label\", \"team_display_order\", \"display_order\", \"show_on_team\" from \"vagaro_service_categories\" where \"vagaro_service_categories\".\"is_active\" = ?",
      "kind": "exact",
      "params": [
        1
      ]
    },
    {
      "sql": "select \"id\", \"team_member_id\", \"fact_type\", \"custom_label\", \"value\", \"custom_icon\", \"display_order\", \"created_at\", \"updated_at\" from \"team_quick_facts\" where \"team_quick_facts\".\"team_member_id\" in (?, ?) order by \"team_quick_facts\".\"display_order\" asc",
      "kind": "team-ids",
      "params": []
    },
    {
      "sql": "select \"team_member_id\", \"crop_square_url\", \"crop_close_up_circle_url\", \"crop_medium_circle_url\", \"crop_full_vertical_url\" from \"team_member_photos\" where (\"team_member_photos\".\"team_member_id\" in (?, ?) and \"team_member_photos\".\"is_primary\" = ?)",
      "kind": "team-photos",
      "params": []
    },
    {
      "sql": "select \"assets\".\"file_path\", \"assets\".\"width\", \"assets\".\"height\", \"assets\".\"blur_data_url\" from \"work_with_us_carousel_photos\" left join \"assets\" on \"work_with_us_carousel_photos\".\"asset_id\" = \"assets\".\"id\" where (\"work_with_us_carousel_photos\".\"is_enabled\" = ? and \"assets\".\"recovery_status\" is null) order by \"work_with_us_carousel_photos\".\"sort_order\" asc",
      "kind": "exact",
      "params": [
        1
      ]
    },
    {
      "sql": "select \"id\", \"source\", \"source_url\", \"source_urls\", \"reviewer_name\", \"subject\", \"team_member_id\", \"review_text\", \"rating\", \"review_date\", \"response_text\", \"response_date\", \"raw_payload\", \"show_on_website\", \"include_in_schema\", \"homepage_dismissed\", \"hidden_reason\", \"quality_scored_at\", \"editor_notes\", \"admin_locked_fields\", \"created_at\", \"updated_at\" from \"reviews\" where (\"reviews\".\"id\" in (?, ?) and \"reviews\".\"show_on_website\" = ?)",
      "kind": "review-ids",
      "params": []
    },
    {
      "sql": "select \"id\", \"name\" from \"team_members\" where \"team_members\".\"id\" in (?, ?)",
      "kind": "team-ids",
      "params": []
    },
    {
      "sql": "select \"id\", \"source\", \"source_url\", \"source_urls\", \"reviewer_name\", \"subject\", \"team_member_id\", \"review_text\", \"rating\", \"review_date\", \"response_text\", \"response_date\", \"raw_payload\", \"show_on_website\", \"include_in_schema\", \"homepage_dismissed\", \"hidden_reason\", \"quality_scored_at\", \"editor_notes\", \"admin_locked_fields\", \"created_at\", \"updated_at\" from \"reviews\" where (\"reviews\".\"rating\" >= ? and \"reviews\".\"show_on_website\" = ?) order by \"reviews\".\"review_date\" desc limit ?",
      "kind": "high-rated",
      "params": []
    }
