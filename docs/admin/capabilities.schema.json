{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lashpopstudios.com/schemas/admin-capabilities.schema.json",
  "title": "LashPop admin capability contract",
  "type": "object",
  "required": ["version", "updated", "title", "purpose", "outsideAdmin", "capabilities"],
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "updated": { "type": "string", "format": "date" },
    "title": { "type": "string", "minLength": 1 },
    "purpose": { "type": "string", "minLength": 1 },
    "outsideAdmin": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "area", "route", "questions", "verificationMode", "evidence"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "area": { "type": "string", "minLength": 1 },
          "route": { "type": "string", "pattern": "^/admin(?:/|$)" },
          "questions": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^(How|Where|What).*\\?$" } },
          "verificationMode": { "type": "string", "minLength": 1 },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["file", "contains"],
              "properties": {
                "file": { "type": "string", "minLength": 1 },
                "contains": { "type": "array", "items": { "type": "string", "minLength": 1 } }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
