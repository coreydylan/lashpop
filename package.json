{
  "name": "lashpop",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "check:design": "node scripts/check-design-contract.mjs",
    "check:admin-capabilities": "node scripts/check-admin-capabilities.mjs",
    "check:owner-guide": "tsx scripts/generate-admin-owner-guide.ts --check",
    "guide:generate": "tsx scripts/generate-admin-owner-guide.ts",
    "test:admin-live": "node scripts/check-admin-live.mjs",
    "audit": "npm audit --audit-level=low",
    "check:visual-coverage": "tsx scripts/check-visual-coverage.ts",
    "test:visual": "npm run check:visual-coverage && playwright test --project=visual-desktop --project=visual-mobile --project=visual-narrow",
    "test:a11y": "playwright test --project=accessibility",
    "test:browser-gates": "node scripts/run-browser-gates.mjs",
    "test:analytics": "NODE_OPTIONS='--conditions=react-server' tsx --test src/lib/analytics-events.test.ts src/lib/interaction-analytics.test.ts src/lib/admin-analytics.test.ts src/lib/admin-analytics-boundary.test.ts",
    "test:interaction-analytics": "node scripts/run-interaction-analytics-browser-gate.mjs",
    "test:launch": "npm run check:admin-capabilities && npm run check:owner-guide && npm run check:design && npm run check:visual-coverage && npm run audit && npm run lint && npm run types && npm run test:analytics && npm run test:vagaro && npm run test:quiz && npm run test:images && npm run test:storage && npm run test:fixtures && npm run test:public-content && npm run test:staff && PLAYWRIGHT_FIXTURES=1 NEXT_PUBLIC_MAPBOX_TOKEN=pk.ci-fixture CLOUDFLARE_DB_URL=http://127.0.0.1:65534 CLOUDFLARE_DB_TOKEN=fixture npm run build && PLAYWRIGHT_FIXTURES=1 NEXT_PUBLIC_MAPBOX_TOKEN=pk.ci-fixture CLOUDFLARE_DB_URL=http://127.0.0.1:65534 CLOUDFLARE_DB_TOKEN=fixture npm run test:browser-gates && PLAYWRIGHT_FIXTURES=1 NEXT_PUBLIC_MAPBOX_TOKEN=pk.ci-fixture CLOUDFLARE_DB_URL=http://127.0.0.1:65534 CLOUDFLARE_DB_TOKEN=fixture npm run test:interaction-analytics",
    "types": "tsc --noEmit",
    "test:vagaro-widget": "tsx --test src/lib/vagaro-widget.test.ts",
    "test:vagaro-embed": "tsx --test src/lib/vagaro-embed-contract.test.ts",
    "test:vagaro-health": "tsx --test workers/vagaro-sync/src/booking-health.test.ts",
    "test:vagaro-images": "tsx --test workers/vagaro-sync/src/cloudflare-images.test.ts",
    "test:vagaro-manifest": "tsx --test workers/vagaro-sync/src/vagaro-widget-manifest.test.ts",
    "test:vagaro-readiness": "tsx --test src/lib/vagaro-booking-readiness.test.ts",
    "test:quiz": "tsx --test src/components/find-your-look/*.test.ts",
    "test:images": "tsx --test src/lib/cf-image-loader.test.ts src/components/service-browser/service-image-preloader.test.ts workers/lashpop-img/src/index.test.mjs scripts/cloudflare-images/format-policy.test.mjs",
    "test:storage": "tsx --test src/lib/dam/r2-client.test.ts src/lib/dam/cloudflare-images.test.ts",
    "images:audit-sources": "node scripts/cloudflare-images/audit-sources.mjs",
    "images:backfill": "node scripts/cloudflare-images/backfill.mjs",
    "images:generate-manifest": "node scripts/cloudflare-images/generate-public-manifest.mjs",
    "images:migrate-direct": "node scripts/cloudflare-images/migrate-direct-delivery.mjs",
    "images:verify-direct": "node scripts/cloudflare-images/verify-direct.mjs",
    "images:verify-hosted": "node scripts/cloudflare-images/verify-hosted.mjs",
    "test:fixtures": "node scripts/check-browser-fixtures.mjs",
    "test:public-content": "tsx --test src/lib/public-faq-categories.test.ts src/lib/public-service-presentation.test.ts src/lib/newsletter-persistence.test.ts src/types/studio.test.ts",
    "test:staff": "tsx --test src/lib/team-publication-contract.test.ts src/lib/admin/team-presentation.test.ts src/lib/admin/owner-guide-content.test.ts src/lib/team-portrait.test.ts src/lib/admin/vagaro-owner-workflows.test.ts src/db/migrations-cascade.test.ts",
    "test:vagaro": "npm run test:vagaro-widget && npm run test:vagaro-embed && npm run test:vagaro-health && npm run test:vagaro-images && npm run test:vagaro-manifest && npm run test:vagaro-readiness && npm run test:roster-reconcile",
    "fixtures:browser:refresh": "DOTENV_CONFIG_PATH=.env.production.local tsx -r dotenv/config scripts/export-browser-fixture.ts --write",
    "vagaro:widgets:audit": "tsx scripts/vagaro-widget-admin.ts audit",
    "vagaro:widgets:refresh": "tsx scripts/vagaro-widget-admin.ts refresh --apply",
    "prebuild": "npm run test:vagaro && npm run test:quiz",
    "validate:seo-migration": "node scripts/validate-seo-migration.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:status": "drizzle-kit status",
    "db:seed": "tsx src/db/seed-all.ts",
    "dev:original": "next dev",
    "test:roster-reconcile": "tsx --test workers/vagaro-sync/src/reconcile.test.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@clerk/nextjs": "^6.39.6",
    "@gsap/react": "^2.1.2",
    "@tanstack/react-query": "^5.90.9",
    "@tanstack/react-query-devtools": "^5.90.2",
    "@tanstack/react-virtual": "^3.13.12",
    "@types/mapbox-gl": "^3.4.1",
    "@types/node": "^24.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "^0.181.0",
    "@vercel/analytics": "^1.6.1",
    "@vercel/speed-insights": "^2.0.0",
    "autoprefixer": "^10.4.21",
    "aws4fetch": "^1.0.20",
    "better-auth": "^1.6.23",
    "clsx": "^2.1.1",
    "dotenv": "^16.5.0",
    "drizzle-orm": "^0.45.2",
    "embla-carousel-auto-scroll": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "embla-carousel-wheel-gestures": "^8.1.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.0",
    "framer-motion": "^12.23.24",
    "gsap": "^3.13.0",
    "lucide-react": "^0.541.0",
    "mapbox-gl": "^3.28.1",
    "nanoid": "^5.1.16",
    "next": "^16.3.0",
    "plaiceholder": "^3.0.0",
    "postcss": "^8.5.26",
    "postgres": "^3.4.7",
    "posthog-js": "^1.422.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-photo-view": "^1.2.7",
    "react-swipeable": "^7.0.2",
    "sanitize-html": "^2.17.6",
    "sharp": "^0.35.3",
    "stripe": "^18.2.1",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^3.4.19",
    "three": "^0.181.2",
    "twilio": "^5.13.1",
    "typescript": "^5.9.2"
  },
  "overrides": {
    "esbuild": "$esbuild",
    "tsx": {
      "esbuild": "0.28.1"
    }
  },
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Firefox versions",
    "last 2 Safari versions",
    "last 2 Edge versions",
    "iOS >= 16",
    "not dead"
  ],
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.1",
    "@types/sanitize-html": "^2.16.1",
    "detect-port": "^2.1.0",
    "drizzle-kit": "^0.31.1",
    "eruda": "^3.4.3",
    "esbuild": "0.25.10",
    "tsx": "^4.20.6"
  }
}
